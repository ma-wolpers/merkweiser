<?xml version="1.0" encoding="utf-8"?>
<!-- Wird beim Build automatisch in das App-Manifest eingemischt (Manifest-Merger). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Löst eine geplante Benachrichtigung aus (AlarmManager). -->
        <receiver
            android:name="de.merkweiser.notify.AlarmReceiver"
            android:exported="false" />
        <!-- Plant nach Neustart bzw. App-Update die gespeicherten Benachrichtigungen neu. -->
        <receiver
            android:name="de.merkweiser.notify.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
